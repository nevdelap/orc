{
  "comment": "Keep this equivalent to .codex/rules/default.rules' prefix_rules list.",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sed *)",
      "Bash(pwd *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(python *)"
    ],
    "defaultMode": "auto"
  }
}
